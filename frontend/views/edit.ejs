<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit &amp; Replace Slip #<%= delivery.id %> | MEDICITY PHARMACEUTICAL HARIPAD</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
</head>

<body>

  <!-- Top Wholesale Shop Header -->
  <header class="app-header wholesale-grand-header no-print">
    <div class="header-container">
      <div class="brand-section">
        <div class="brand-logo-icon">
          <i class="ri-edit-2-line"></i>
        </div>
        <div class="brand-title">
          <div class="wholesale-distributor-badge">
            <i class="ri-award-fill"></i> WHOLESALE PHARMACEUTICAL DISTRIBUTOR
          </div>
          <h1 class="main-shop-heading" style="font-size: 1.5rem;">MEDICITY PHARMACEUTICAL HARIPAD</h1>
          <div class="brand-subtitle">
            <span class="location-badge">Haripad, Alappuzha, Kerala</span>
            <span>Delivery Slip Correction &amp; Replacement Desk</span>
          </div>
        </div>
      </div>
      <div class="header-user-controls">
        <div class="header-nav-links">
          <a href="/" class="nav-btn"><i class="ri-dashboard-line"></i> Dashboard</a>
          <% if (currentUser && currentUser.role==='admin' ) { %>
            <a href="/admin/medicines" class="nav-btn"><i class="ri-medicine-bottle-line"></i> Medicine Rates</a>
            <% } %>
              <a href="/history" class="nav-btn"><i class="ri-archive-line"></i> Delivery Slips</a>
        </div>

        <div class="user-profile-pill <%= currentUser && currentUser.role === 'admin' ? 'admin-pill' : '' %>">
          <span class="user-avatar-circle <%= currentUser && currentUser.role === 'admin' ? 'admin-avatar' : '' %>">
            <i
              class="<%= currentUser && currentUser.role === 'admin' ? 'ri-shield-star-fill' : 'ri-user-star-line' %>"></i>
          </span>
          <div class="user-info-text">
            <span class="user-role">
              <%= currentUser && currentUser.role==='admin' ? 'Administrator' : 'Delivery Worker' %>
            </span>
            <span class="user-name">
              <%= currentUser ? currentUser.username : 'Worker' %>
            </span>
          </div>
        </div>

        <a href="/logout" class="btn btn-sm btn-logout" title="Sign Out">
          <i class="ri-logout-box-r-line"></i> Sign Out
        </a>
      </div>
    </div>
  </header>

  <main class="main-wrapper upload-page-wrapper" style="margin-top: -20px;">

    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav">
      <a href="/"><i class="ri-dashboard-line"></i> Dashboard</a>
      <span class="breadcrumb-sep"><i class="ri-arrow-right-s-line"></i></span>
      <a href="/history"><i class="ri-history-line"></i> History</a>
      <span class="breadcrumb-sep"><i class="ri-arrow-right-s-line"></i></span>
      <span class="breadcrumb-current">Edit &amp; Replace Slip #<%= delivery.id %></span>
    </nav>

    <!-- Error/Notice Alerts -->
    <% if (error) { %>
      <div class="alert alert-error">
        <div><i class="ri-error-warning-fill"></i>
          <%= error %>
        </div>
      </div>
      <% } %>

        <div class="upload-container">

          <!-- Left Edit / Replace Card -->
          <section class="card upload-card" style="border-top: 5px solid #d97706;">

            <div class="upload-card-header"
              style="border-bottom: 1px solid var(--surface-border); background: #fffbeb;">
              <div class="channel-icon-large" style="background: #fef3c7; color: #d97706;">
                <i class="ri-edit-box-line"></i>
              </div>
              <div class="channel-header-text">
                <div class="channel-pill" style="background: #fef3c7; color: #b45309;">
                  <i class="ri-pencil-line"></i> EDIT / REPLACE SLIP
                </div>
                <h2>Correct Slip Details or Replace Photo</h2>
                <p>Modify date, recipient, order reference, or replace wrong photo with new signed paper slip</p>
              </div>
            </div>

            <form action="/deliveries/<%= delivery.id %>/edit" method="POST" enctype="multipart/form-data"
              class="upload-form">

              <div class="form-grid-2">
                <!-- Delivery Date -->
                <div class="form-group">
                  <label class="form-label" for="delivery_date">
                    <i class="ri-calendar-2-line"></i> Delivery Date <span class="required">*</span>
                  </label>
                  <input type="date" id="delivery_date" name="delivery_date" class="form-control"
                    value="<%= delivery.delivery_date %>" required>
                </div>

                <!-- Service Channel Dropdown -->
                <div class="form-group">
                  <label class="form-label" for="service_type">
                    <i class="ri-store-2-line"></i> Service Channel <span class="required">*</span>
                  </label>
                  <select id="service_type" name="service_type" class="form-control" required>
                    <option value="Neethi Store" <%=delivery.service_type==='Neethi Store' ? 'selected' : '' %>>Neethi
                      Medical Store</option>
                    <option value="Supplyco" <%=delivery.service_type==='Supplyco' ? 'selected' : '' %>>Supplyco
                      Pharmacy</option>
                    <option value="Direct Govt Order" <%=delivery.service_type==='Direct Govt Order' ? 'selected' : ''
                      %>>Direct Govt / Taluk Hospital</option>
                  </select>
                </div>
              </div>

              <!-- Destination Store / Hospital Name -->
              <div class="form-group">
                <label class="form-label" for="hospital_name">
                  <i class="ri-map-pin-line"></i> Delivered Neethi Store Branch or Delivered Hospital Name <span class="required">*</span>
                </label>
                <input type="text" id="hospital_name" name="hospital_name" class="form-control"
                  value="<%= delivery.hospital_name %>" required>
                <span class="form-help">Store branch, PHC, CHC, or hospital receiving medicines</span>
              </div>

              <!-- Medicity Invoice Number -->
              <div class="form-group">
                <label class="form-label" for="order_number">
                  <i class="ri-file-text-line"></i> Medicity Invoice Number <span class="required">*</span>
                </label>
                <input type="text" id="order_number" name="order_number" class="form-control"
                  value="<%= delivery.order_number %>" required>
                <span class="form-help">Medicity Wholesale Invoice / Challan Reference number</span>
              </div>

              <!-- Delivery Boy / Staff Details -->
              <div class="form-group">
                <label class="form-label" for="delivery_boy">
                  <i class="ri-user-star-line"></i> Who Delivered (Delivery Boy / Staff) <span class="required">*</span>
                </label>
                <% const currentBoy = (delivery.delivery_boy || delivery.created_by || '').trim(); %>
                <select id="delivery_boy" name="delivery_boy" class="form-control" required onchange="onDeliveryBoySelectChange(this.value)">
                  <option value="" disabled <%= !currentBoy ? 'selected' : '' %>>-- Click to Select Who Delivered Medicines --</option>
                  <option value="Ansar" <%= currentBoy.toLowerCase() === 'ansar' ? 'selected' : '' %>>Ansar</option>
                  <option value="Haris" <%= currentBoy.toLowerCase() === 'haris' ? 'selected' : '' %>>Haris</option>
                  <option value="Jasim" <%= currentBoy.toLowerCase() === 'jasim' ? 'selected' : '' %>>Jasim</option>
                  <option value="Akbarsha" <%= currentBoy.toLowerCase() === 'akbarsha' ? 'selected' : '' %>>Akbarsha</option>
                  <option value="Sajid" <%= currentBoy.toLowerCase() === 'sajid' ? 'selected' : '' %>>Sajid</option>
                  <option value="Vishnu" <%= currentBoy.toLowerCase() === 'vishnu' ? 'selected' : '' %>>Vishnu</option>
                  <% if (currentBoy && !['ansar','haris','jasim','akbarsha','sajid','vishnu'].includes(currentBoy.toLowerCase())) { %>
                    <option value="<%= currentBoy %>" selected><%= currentBoy %> (Custom)</option>
                  <% } %>
                </select>

                <!-- Quick-Tap Delivery Boy Selection Pills -->
                <div class="delivery-boy-pills-wrap">
                  <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; margin-right: 4px;"><i class="ri-flashlight-fill" style="color: #f59e0b;"></i> Quick Select:</span>
                  <button type="button" class="delivery-boy-pill-btn <%= currentBoy.toLowerCase() === 'ansar' ? 'active' : '' %>" onclick="selectDeliveryBoy('Ansar')"><i class="ri-user-smile-line"></i> Ansar</button>
                  <button type="button" class="delivery-boy-pill-btn <%= currentBoy.toLowerCase() === 'haris' ? 'active' : '' %>" onclick="selectDeliveryBoy('Haris')"><i class="ri-user-smile-line"></i> Haris</button>
                  <button type="button" class="delivery-boy-pill-btn <%= currentBoy.toLowerCase() === 'jasim' ? 'active' : '' %>" onclick="selectDeliveryBoy('Jasim')"><i class="ri-user-smile-line"></i> Jasim</button>
                  <button type="button" class="delivery-boy-pill-btn <%= currentBoy.toLowerCase() === 'akbarsha' ? 'active' : '' %>" onclick="selectDeliveryBoy('Akbarsha')"><i class="ri-user-smile-line"></i> Akbarsha</button>
                  <button type="button" class="delivery-boy-pill-btn <%= currentBoy.toLowerCase() === 'sajid' ? 'active' : '' %>" onclick="selectDeliveryBoy('Sajid')"><i class="ri-user-smile-line"></i> Sajid</button>
                  <button type="button" class="delivery-boy-pill-btn <%= currentBoy.toLowerCase() === 'vishnu' ? 'active' : '' %>" onclick="selectDeliveryBoy('Vishnu')"><i class="ri-user-smile-line"></i> Vishnu</button>
                </div>
                <span class="form-help">Click the dropdown or tap any delivery boy name above to update who delivered</span>
              </div>

              <!-- Current & New Slip Image Area -->
              <div class="form-group upload-file-group">
                <label class="form-label">
                  <i class="ri-camera-lens-fill"></i> Signed Delivery Slip Photo
                </label>

                <div class="current-slip-preview-box">
                  <div class="current-slip-thumb-wrap">
                    <img src="<%= delivery.signed_proof_path %>" alt="Current Slip" class="current-slip-image"
                      onerror="this.src='/uploads/sample_slip_neethi.svg'">
                  </div>
                  <div class="current-slip-info">
                    <strong>Current Active Photo</strong>
                    <p>Select below only if you want to replace this existing paper slip photo with a new photo.</p>
                    <a href="<%= delivery.signed_proof_path %>" target="_blank" class="btn btn-sm btn-secondary"
                      style="margin-top: 8px;">
                      <i class="ri-zoom-in-line"></i> View Current Full Photo
                    </a>
                  </div>
                </div>

                <!-- Hidden Master replacement file input -->
                <input type="file" id="signed_proof" name="signed_proof"
                  accept="image/jpeg,image/png,image/webp,image/jpg" style="position: absolute; width: 1px; height: 1px; opacity: 0;"
                  onchange="handleMasterFileChange(this)">

                <!-- Hidden inputs for Camera and Files -->
                <input type="file" id="cameraDirectInput" accept="image/*" capture="environment" style="display: none;" onchange="handleFileSelected(this, 'Camera')">
                <input type="file" id="galleryDirectInput" accept="image/jpeg,image/png,image/webp,image/jpg" style="display: none;" onchange="handleFileSelected(this, 'Files')">

                <!-- DUAL CHOICE ACTION BOX (Optional Replacement) -->
                <div class="dual-choice-wrapper" id="dualChoiceBox" style="margin-top: 14px;">
                  <div class="dual-choice-header">
                    <h4><i class="ri-camera-switch-line"></i> Replace Current Photo (Optional)</h4>
                    <p>Snap fresh photo with camera or choose from existing files to replace the active slip</p>
                  </div>

                  <div class="dual-choice-grid">
                    <div class="choice-card choice-camera" onclick="triggerCameraCapture()" role="button" tabindex="0">
                      <div class="choice-icon-wrap bg-camera-icon">
                        <i class="ri-camera-lens-fill"></i>
                      </div>
                      <span class="choice-badge">OPTION 1</span>
                      <h3 class="choice-title">Directly Snap with Camera</h3>
                      <p class="choice-desc">Open camera now to click a new replacement photo</p>
                      <span class="btn-choice-action">
                        <i class="ri-camera-fill"></i> Snap New Photo
                      </span>
                    </div>

                    <div class="choice-card choice-gallery" onclick="triggerFilePicker()" role="button" tabindex="0">
                      <div class="choice-icon-wrap bg-gallery-icon">
                        <i class="ri-folder-image-fill"></i>
                      </div>
                      <span class="choice-badge">OPTION 2</span>
                      <h3 class="choice-title">Upload with Files</h3>
                      <p class="choice-desc">Browse device gallery or scanned documents</p>
                      <span class="btn-choice-action">
                        <i class="ri-upload-cloud-2-fill"></i> Choose New File
                      </span>
                    </div>
                  </div>
                </div>

                <!-- NEW REPLACEMENT PREVIEW (After selection) -->
                <div class="preview-container-card" id="previewContainer" style="display: none; margin-top: 14px;">
                  <div class="preview-card-header">
                    <div class="preview-badge-status" id="previewSourceBadge">
                      <i class="ri-checkbox-circle-fill"></i> New Replacement Photo Selected
                    </div>
                    <div class="preview-action-buttons">
                      <button type="button" class="btn btn-sm btn-outline-camera" onclick="triggerCameraCapture()">
                        <i class="ri-camera-line"></i> Retake
                      </button>
                      <button type="button" class="btn btn-sm btn-outline-file" onclick="triggerFilePicker()">
                        <i class="ri-folder-image-line"></i> Change File
                      </button>
                      <button type="button" class="btn btn-sm btn-danger-remove" onclick="resetProofPhoto()">
                        <i class="ri-delete-bin-line"></i> Cancel Replacement
                      </button>
                    </div>
                  </div>

                  <div class="preview-img-wrapper">
                    <img id="imagePreview" src="" alt="New Slip Preview" class="preview-img-element">
                  </div>

                  <div class="preview-meta-bar">
                    <span id="previewFileName" class="preview-file-title"></span>
                    <span id="previewFileSize" class="preview-file-size"></span>
                  </div>
                </div>

              </div>

              <!-- Form Action Buttons -->
              <div class="form-actions">
                <a href="/deliveries/<%= delivery.id %>" class="btn btn-secondary">
                  <i class="ri-close-line"></i> Cancel
                </a>
                <button type="submit" class="btn btn-primary" style="background: #d97706; border-color: #d97706;">
                  <i class="ri-save-line"></i>
                  <span>Save Slip Updates</span>
                </button>
              </div>

            </form>

          </section>

        </div>

  </main>

  <footer class="app-footer">
    <div class="footer-container">
      <p>&copy; MEDICITY PHARMACEUTICAL HARIPAD &bull; Wholesale Institutional Medicine Supply Desk</p>
    </div>
  </footer>

  <script>
    function triggerCameraCapture() {
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
      document.getElementById('cameraDirectInput').click();
    }

    function triggerFilePicker() {
      document.getElementById('galleryDirectInput').click();
    }

    function handleFileSelected(input, sourceLabel) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        setMasterFile(file, sourceLabel);
      }
    }

    function handleMasterFileChange(input) {
      if (input.files && input.files[0]) {
        displayPreview(input.files[0], 'Uploaded File');
      }
    }

    function setMasterFile(file, sourceLabel) {
      const masterInput = document.getElementById('signed_proof');
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        masterInput.files = dt.files;
      } catch (err) {
        console.warn('DataTransfer fallback:', err);
      }
      displayPreview(file, sourceLabel);
    }

    function displayPreview(file, sourceLabel) {
      const dualChoiceBox = document.getElementById('dualChoiceBox');
      const previewContainer = document.getElementById('previewContainer');
      const imagePreview = document.getElementById('imagePreview');
      const previewFileName = document.getElementById('previewFileName');
      const previewFileSize = document.getElementById('previewFileSize');
      const previewSourceBadge = document.getElementById('previewSourceBadge');

      const reader = new FileReader();
      reader.onload = function(e) {
        imagePreview.src = e.target.result;
        previewFileName.textContent = 'New Replacement: ' + (file.name || 'slip.jpg');
        previewFileSize.textContent = (file.size / 1024).toFixed(1) + ' KB';
        
        if (sourceLabel === 'Camera') {
          previewSourceBadge.innerHTML = '<i class="ri-camera-fill"></i> New Photo Snapped via Camera';
          previewSourceBadge.style.background = '#ccfbf1';
          previewSourceBadge.style.color = '#0f766e';
        } else {
          previewSourceBadge.innerHTML = '<i class="ri-folder-image-fill"></i> New Photo Uploaded from Files';
          previewSourceBadge.style.background = '#e0f2fe';
          previewSourceBadge.style.color = '#0284c7';
        }

        dualChoiceBox.style.display = 'none';
        previewContainer.style.display = 'block';
      };
      reader.readAsDataURL(file);
    }

    function resetProofPhoto() {
      const masterInput = document.getElementById('signed_proof');
      const cameraInput = document.getElementById('cameraDirectInput');
      const galleryInput = document.getElementById('galleryDirectInput');
      const dualChoiceBox = document.getElementById('dualChoiceBox');
      const previewContainer = document.getElementById('previewContainer');
      const imagePreview = document.getElementById('imagePreview');

      masterInput.value = '';
      if (cameraInput) cameraInput.value = '';
      if (galleryInput) galleryInput.value = '';
      imagePreview.src = '';

      dualChoiceBox.style.display = 'block';
      previewContainer.style.display = 'none';
    }

    // Delivery Boy Quick Selector Functions
    function selectDeliveryBoy(name) {
      const select = document.getElementById('delivery_boy');
      if (select) {
        select.value = name;
      }
      updateDeliveryBoyPillHighlight(name);
    }

    function onDeliveryBoySelectChange(name) {
      updateDeliveryBoyPillHighlight(name);
    }

    function updateDeliveryBoyPillHighlight(name) {
      document.querySelectorAll('.delivery-boy-pill-btn').forEach(btn => {
        if (btn.textContent.trim().toLowerCase().includes(name.toLowerCase())) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }
  </script>

</body>

</html>