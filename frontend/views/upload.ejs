<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= channelInfo.title %> | MEDICITY PHARMACEUTICAL HARIPAD
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
</head>

<body>

  <!-- Top App Header -->
  <header class="app-header wholesale-grand-header">
    <div class="header-container">
      <div class="brand-section">
        <div class="brand-logo-icon">
          <i class="ri-hospital-line"></i>
        </div>
        <div class="brand-title">
          <div class="wholesale-distributor-badge">
            <i class="ri-award-fill"></i> WHOLESALE PHARMACEUTICAL DISTRIBUTOR
          </div>
          <h1 class="main-shop-heading">MEDICITY PHARMACEUTICAL HARIPAD</h1>
          <div class="brand-subtitle">
            <span class="location-badge"><i class="ri-map-pin-2-fill"></i> Haripad, Alappuzha, Kerala</span>
            <span>Delivery Proof Slip Capture &bull; <%= channelInfo.name %> Channel</span>
          </div>
        </div>
      </div>
      <div class="header-user-controls">
        <div class="header-nav-links">
          <a href="/" class="nav-btn"><i class="ri-dashboard-line"></i> Dashboard</a>
          <% if (currentUser && currentUser.role === 'admin') { %>
            <a href="/admin/medicines" class="nav-btn"><i class="ri-medicine-bottle-line"></i> Medicine Rates</a>
          <% } %>
          <a href="/history" class="nav-btn"><i class="ri-archive-line"></i> Delivery Slips</a>
        </div>

        <div class="user-profile-pill <%= currentUser && currentUser.role === 'admin' ? 'admin-pill' : '' %>">
          <span class="user-avatar-circle <%= currentUser && currentUser.role === 'admin' ? 'admin-avatar' : '' %>">
            <i class="<%= currentUser && currentUser.role === 'admin' ? 'ri-shield-star-fill' : 'ri-user-star-line' %>"></i>
          </span>
          <div class="user-info-text">
            <span class="user-role"><%= currentUser && currentUser.role === 'admin' ? 'Administrator' : 'Delivery Worker' %></span>
            <span class="user-name"><%= currentUser ? currentUser.username : 'Worker' %></span>
          </div>
        </div>

        <a href="/logout" class="btn btn-sm btn-logout" title="Sign Out">
          <i class="ri-logout-box-r-line"></i> Sign Out
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Wrapper -->
  <main class="main-wrapper upload-page-wrapper">

    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb-nav">
      <a href="/"><i class="ri-dashboard-line"></i> Dashboard</a>
      <span class="breadcrumb-sep"><i class="ri-arrow-right-s-line"></i></span>
      <span class="breadcrumb-current">
        <%= channelInfo.title %>
      </span>
    </nav>

    <!-- Upload Card Container -->
    <div class="upload-container">

      <section class="card upload-card channel-<%= channelKey %>">

        <!-- Channel Header Banner -->
        <div class="upload-card-header" style="border-bottom: 2px solid <%= channelInfo.accentColor %>;">
          <div class="channel-icon-large"
            style="background: <%= channelInfo.bgLight %>; color: <%= channelInfo.accentColor %>;">
            <i class="<%= channelInfo.icon %>"></i>
          </div>
          <div class="channel-header-text">
            <div class="channel-pill"
              style="background: <%= channelInfo.bgLight %>; color: <%= channelInfo.accentColor %>;">
              <i class="ri-checkbox-circle-fill"></i>
              <%= channelInfo.name %> CHANNEL
            </div>
            <h2>
              <%= channelInfo.title %>
            </h2>
            <p>
              <%= channelInfo.subtitle %>
            </p>
          </div>
        </div>

        <!-- Feedback Alerts -->
        <% if (error) { %>
          <div class="alert alert-error" style="margin: 20px 24px 0;">
            <div><i class="ri-error-warning-fill"></i>
              <%= error %>
            </div>
          </div>
          <% } %>

            <% if (message) { %>
              <div class="alert alert-success" style="margin: 20px 24px 0;">
                <div><i class="ri-checkbox-circle-fill"></i>
                  <%= message %>
                </div>
              </div>
              <% } %>

                <!-- Upload Form -->
                <form action="/deliveries" method="POST" enctype="multipart/form-data" class="upload-form">

                  <!-- Hidden fixed channel service_type -->
                  <input type="hidden" name="service_type" value="<%= channelInfo.serviceType %>">
                  <input type="hidden" name="return_channel" value="<%= channelKey %>">

                  <div class="form-grid-2">
                    <!-- Delivery Date -->
                    <div class="form-group">
                      <label class="form-label" for="delivery_date">
                        <i class="ri-calendar-2-line"></i> Delivery Date <span class="required">*</span>
                      </label>
                      <input type="date" id="delivery_date" name="delivery_date" class="form-control"
                        value="<%= todayDate %>" required>
                      <span class="form-help">Date when the medicines were delivered</span>
                    </div>

                    <!-- Medicity Invoice Number -->
                    <div class="form-group">
                      <label class="form-label" for="order_number">
                        <i class="ri-file-text-line"></i>
                        <%= channelInfo.orderLabel %> <span class="required">*</span>
                      </label>
                      <input type="text" id="order_number" name="order_number" class="form-control"
                        placeholder="<%= channelInfo.orderPlaceholder %>" required>
                      <span class="form-help">Medicity Wholesale Invoice / Challan Reference number</span>
                    </div>
                  </div>

                  <!-- Destination Store / Hospital Name -->
                  <div class="form-group">
                    <label class="form-label" for="hospital_name">
                      <i class="ri-map-pin-line"></i>
                      <%= channelInfo.locationLabel %> <span class="required">*</span>
                    </label>
                    <input type="text" id="hospital_name" name="hospital_name" class="form-control"
                      placeholder="<%= channelInfo.locationPlaceholder %>" required>
                    <span class="form-help">Delivered Neethi Store branch, Supplyco branch, PHC, CHC or Hospital receiving medicines</span>
                  </div>

                  <!-- Delivery Boy / Staff Details -->
                  <div class="form-group">
                    <label class="form-label" for="delivery_boy">
                      <i class="ri-user-star-line"></i> Who Delivered (Delivery Boy / Staff) <span class="required">*</span>
                    </label>
                    <select id="delivery_boy" name="delivery_boy" class="form-control" required onchange="onDeliveryBoySelectChange(this.value)">
                      <option value="" disabled selected>-- Click to Select Who Delivered Medicines --</option>
                      <option value="Ansar">Ansar</option>
                      <option value="Haris">Haris</option>
                      <option value="Jasim">Jasim</option>
                      <option value="Akbarsha">Akbarsha</option>
                      <option value="Sajid">Sajid</option>
                      <option value="Vishnu">Vishnu</option>
                    </select>
                    
                    <!-- Quick-Tap Delivery Boy Selection Pills -->
                    <div class="delivery-boy-pills-wrap">
                      <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; margin-right: 4px;"><i class="ri-flashlight-fill" style="color: #f59e0b;"></i> Quick Select:</span>
                      <button type="button" class="delivery-boy-pill-btn" onclick="selectDeliveryBoy('Ansar')"><i class="ri-user-smile-line"></i> Ansar</button>
                      <button type="button" class="delivery-boy-pill-btn" onclick="selectDeliveryBoy('Haris')"><i class="ri-user-smile-line"></i> Haris</button>
                      <button type="button" class="delivery-boy-pill-btn" onclick="selectDeliveryBoy('Jasim')"><i class="ri-user-smile-line"></i> Jasim</button>
                      <button type="button" class="delivery-boy-pill-btn" onclick="selectDeliveryBoy('Akbarsha')"><i class="ri-user-smile-line"></i> Akbarsha</button>
                      <button type="button" class="delivery-boy-pill-btn" onclick="selectDeliveryBoy('Sajid')"><i class="ri-user-smile-line"></i> Sajid</button>
                      <button type="button" class="delivery-boy-pill-btn" onclick="selectDeliveryBoy('Vishnu')"><i class="ri-user-smile-line"></i> Vishnu</button>
                    </div>
                    <span class="form-help">Click the dropdown or tap any delivery boy name above to select who delivered</span>
                  </div>

                  <!-- Paper Slip Photo Upload Area (2 Clear Options: Camera & Files) -->
                  <div class="form-group upload-file-group">
                    <label class="form-label">
                      <i class="ri-camera-lens-fill"></i> Signed Paper Delivery Slip Photo <span class="required">*</span>
                    </label>

                    <!-- Master Form File Input -->
                    <input type="file" id="signed_proof" name="signed_proof"
                      accept="image/jpeg,image/png,image/webp,image/jpg" style="position: absolute; width: 1px; height: 1px; opacity: 0;" required
                      onchange="handleMasterFileChange(this)">

                    <!-- Hidden Direct Camera Input (Opens Native Phone Camera instantly) -->
                    <input type="file" id="cameraDirectInput" accept="image/*" capture="environment" style="display: none;" onchange="handleFileSelected(this, 'Camera')">

                    <!-- Hidden Files / Gallery Input -->
                    <input type="file" id="galleryDirectInput" accept="image/jpeg,image/png,image/webp,image/jpg" style="display: none;" onchange="handleFileSelected(this, 'Files')">

                    <!-- DUAL CHOICE ACTION BOX -->
                    <div class="dual-choice-wrapper" id="dualChoiceBox">
                      <div class="dual-choice-header">
                        <h4><i class="ri-camera-3-fill"></i> Choose Delivery Slip Photo Option</h4>
                        <p>Select directly snapping a fresh photo with camera or uploading from existing files</p>
                      </div>

                      <div class="dual-choice-grid">
                        <!-- Option 1: Directly Snap with Camera -->
                        <div class="choice-card choice-camera" onclick="triggerCameraCapture()" role="button" tabindex="0">
                          <div class="choice-icon-wrap bg-camera-icon">
                            <i class="ri-camera-lens-fill"></i>
                          </div>
                          <span class="choice-badge">OPTION 1</span>
                          <h3 class="choice-title">Directly Snap with Camera</h3>
                          <p class="choice-desc">Open camera now to click an instant, live clear photo of the signed paper slip</p>
                          <span class="btn-choice-action">
                            <i class="ri-camera-fill"></i> Snap Photo Now
                          </span>
                        </div>

                        <!-- Option 2: Upload with Files -->
                        <div class="choice-card choice-gallery" onclick="triggerFilePicker()" role="button" tabindex="0">
                          <div class="choice-icon-wrap bg-gallery-icon">
                            <i class="ri-folder-image-fill"></i>
                          </div>
                          <span class="choice-badge">OPTION 2</span>
                          <h3 class="choice-title">Upload with Files</h3>
                          <p class="choice-desc">Browse your phone/computer gallery, recent photos, or scanned image documents</p>
                          <span class="btn-choice-action">
                            <i class="ri-upload-cloud-2-fill"></i> Choose from Files
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- PHOTO PREVIEW CONTAINER (After capture or upload) -->
                    <div class="preview-container-card" id="previewContainer" style="display: none;">
                      <div class="preview-card-header">
                        <div class="preview-badge-status" id="previewSourceBadge">
                          <i class="ri-checkbox-circle-fill"></i> Photo Attached &amp; Ready
                        </div>
                        <div class="preview-action-buttons">
                          <button type="button" class="btn btn-sm btn-outline-camera" onclick="triggerCameraCapture()" title="Retake with camera">
                            <i class="ri-camera-line"></i> Retake (Camera)
                          </button>
                          <button type="button" class="btn btn-sm btn-outline-file" onclick="triggerFilePicker()" title="Choose different file">
                            <i class="ri-folder-image-line"></i> Choose File
                          </button>
                          <button type="button" class="btn btn-sm btn-danger-remove" onclick="resetProofPhoto()" title="Remove photo">
                            <i class="ri-delete-bin-line"></i> Remove
                          </button>
                        </div>
                      </div>

                      <div class="preview-img-wrapper">
                        <img id="imagePreview" src="" alt="Proof Slip Preview" class="preview-img-element">
                      </div>

                      <div class="preview-meta-bar">
                        <span id="previewFileName" class="preview-file-title"></span>
                        <span id="previewFileSize" class="preview-file-size"></span>
                      </div>
                    </div>

                  </div>

                  <!-- Form Action Buttons -->
                  <div class="form-actions">
                    <a href="/" class="btn btn-secondary">
                      <i class="ri-close-line"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary btn-submit-slip">
                      <i class="ri-checkbox-circle-fill"></i>
                      <span>Save &amp; Record Signed Slip</span>
                    </button>
                  </div>

                </form>

      </section>

    </div>

  </main>

  <!-- LIVE CAMERA VIEWFINDER MODAL (For Desktop / Tablet Webcam Live Stream) -->
  <div class="modal-overlay" id="cameraModal" style="display: none;">
    <div class="modal-card" style="max-width: 680px;">
      <div class="modal-header">
        <div class="modal-title-box">
          <div class="modal-icon-badge"><i class="ri-camera-lens-fill"></i></div>
          <div>
            <h3>Live Camera Slip Capture</h3>
            <p>Position the signed paper delivery slip in frame</p>
          </div>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeCameraModal()">&times;</button>
      </div>

      <div class="modal-body">
        <div class="camera-viewfinder-box">
          <video id="cameraVideo" class="camera-video-stream" autoplay playsinline muted></video>
          <canvas id="cameraCanvas" style="display: none;"></canvas>
          <div class="camera-overlay-guides">
            <span><i class="ri-scan-2-line"></i> Align Signed Delivery Slip Here</span>
          </div>
        </div>

        <div class="camera-controls-bar">
          <button type="button" class="btn btn-secondary" onclick="switchCameraFacing()">
            <i class="ri-camera-switch-line"></i> Flip Camera
          </button>
          <button type="button" class="btn-snap-photo" onclick="captureLivePhoto()">
            <i class="ri-camera-fill"></i> Click &amp; Capture Photo
          </button>
        </div>
      </div>
    </div>
  </div>

  <footer class="app-footer">
    <div class="footer-container">
      <p>&copy; MEDICITY PHARMACEUTICAL HARIPAD &bull; Wholesale Institutional Medicine Supply Desk</p>
    </div>
  </footer>

  <script>
    let activeCameraStream = null;
    let currentFacingMode = 'environment';

    // Option 1: Trigger Camera Snap
    function triggerCameraCapture() {
      // Check if mobile device -> open native device camera immediately
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
      
      if (isMobile) {
        document.getElementById('cameraDirectInput').click();
      } else {
        // Desktop / Laptop: Try opening live camera viewfinder modal with WebRTC
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          openCameraModal();
        } else {
          document.getElementById('cameraDirectInput').click();
        }
      }
    }

    // Option 2: Trigger File Picker (Gallery / Documents)
    function triggerFilePicker() {
      document.getElementById('galleryDirectInput').click();
    }

    // Handle File selected from either Camera or File Picker
    function handleFileSelected(input, sourceLabel) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        setMasterFile(file, sourceLabel);
      }
    }

    // Handle Master file change directly
    function handleMasterFileChange(input) {
      if (input.files && input.files[0]) {
        displayPreview(input.files[0], 'Uploaded File');
      }
    }

    // Set Master file using DataTransfer
    function setMasterFile(file, sourceLabel) {
      const masterInput = document.getElementById('signed_proof');
      
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        masterInput.files = dt.files;
      } catch (err) {
        console.warn('DataTransfer not fully supported, using input clone:', err);
      }

      displayPreview(file, sourceLabel);
    }

    // Display high-definition image preview and metadata
    function displayPreview(file, sourceLabel) {
      const dualChoiceBox = document.getElementById('dualChoiceBox');
      const previewContainer = document.getElementById('previewContainer');
      const imagePreview = document.getElementById('imagePreview');
      const previewFileName = document.getElementById('previewFileName');
      const previewFileSize = document.getElementById('previewFileSize');
      const previewSourceBadge = document.getElementById('previewSourceBadge');

      const reader = new FileReader();
      reader.onload = function(e) {
        imagePreview.src = e.target.result;
        previewFileName.textContent = file.name || 'signed_delivery_slip.jpg';
        previewFileSize.textContent = (file.size / 1024).toFixed(1) + ' KB';
        
        if (sourceLabel === 'Camera') {
          previewSourceBadge.innerHTML = '<i class="ri-camera-fill"></i> Photo Snapped via Camera';
          previewSourceBadge.style.background = '#ccfbf1';
          previewSourceBadge.style.color = '#0f766e';
        } else {
          previewSourceBadge.innerHTML = '<i class="ri-folder-image-fill"></i> Uploaded from Device Files';
          previewSourceBadge.style.background = '#e0f2fe';
          previewSourceBadge.style.color = '#0284c7';
        }

        dualChoiceBox.style.display = 'none';
        previewContainer.style.display = 'block';
      };
      reader.readAsDataURL(file);
    }

    // Reset / Remove Photo
    function resetProofPhoto() {
      const masterInput = document.getElementById('signed_proof');
      const cameraInput = document.getElementById('cameraDirectInput');
      const galleryInput = document.getElementById('galleryDirectInput');
      const dualChoiceBox = document.getElementById('dualChoiceBox');
      const previewContainer = document.getElementById('previewContainer');
      const imagePreview = document.getElementById('imagePreview');

      masterInput.value = '';
      if (cameraInput) cameraInput.value = '';
      if (galleryInput) galleryInput.value = '';
      imagePreview.src = '';

      dualChoiceBox.style.display = 'block';
      previewContainer.style.display = 'none';
    }

    // WebRTC Live Camera Modal Handlers (Desktop & Laptop Viewfinder)
    function openCameraModal() {
      const modal = document.getElementById('cameraModal');
      modal.style.display = 'flex';
      startCameraStream();
    }

    function closeCameraModal() {
      const modal = document.getElementById('cameraModal');
      modal.style.display = 'none';
      stopCameraStream();
    }

    function startCameraStream() {
      const video = document.getElementById('cameraVideo');
      stopCameraStream();

      const constraints = {
        video: {
          facingMode: currentFacingMode,
          width: { ideal: 1920 },
          height: { ideal: 1080 }
        }
      };

      navigator.mediaDevices.getUserMedia(constraints)
        .then(stream => {
          activeCameraStream = stream;
          video.srcObject = stream;
        })
        .catch(err => {
          console.error('Webcam stream error:', err);
          closeCameraModal();
          // Fallback to native camera input
          document.getElementById('cameraDirectInput').click();
        });
    }

    function stopCameraStream() {
      if (activeCameraStream) {
        activeCameraStream.getTracks().forEach(track => track.stop());
        activeCameraStream = null;
      }
    }

    function switchCameraFacing() {
      currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment';
      startCameraStream();
    }

    function captureLivePhoto() {
      const video = document.getElementById('cameraVideo');
      const canvas = document.getElementById('cameraCanvas');
      if (!video || !canvas) return;

      canvas.width = video.videoWidth || 1280;
      canvas.height = video.videoHeight || 720;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

      canvas.toBlob(blob => {
        const fileName = 'medicity_slip_' + Date.now() + '.jpg';
        const file = new File([blob], fileName, { type: 'image/jpeg' });
        setMasterFile(file, 'Camera');
        closeCameraModal();
      }, 'image/jpeg', 0.92);
    }

    // Delivery Boy Quick Selector Functions
    function selectDeliveryBoy(name) {
      const select = document.getElementById('delivery_boy');
      if (select) {
        select.value = name;
      }
      updateDeliveryBoyPillHighlight(name);
    }

    function onDeliveryBoySelectChange(name) {
      updateDeliveryBoyPillHighlight(name);
    }

    function updateDeliveryBoyPillHighlight(name) {
      document.querySelectorAll('.delivery-boy-pill-btn').forEach(btn => {
        if (btn.textContent.trim().includes(name)) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }
  </script>

</body>

</html>